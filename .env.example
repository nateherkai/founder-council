# Roast Room can run in three modes:
# - viewer: play councils written by Claude Code or another runner
# - hybrid: Gemini CLI advisor seats + GitHub Copilot Chair (no API key required)
# - api: original Anthropic API runner
COUNCIL_RUNNER=viewer

# Hybrid runner defaults. These reuse your existing authenticated CLI sessions.
CHAIR_PROVIDER=copilot
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CONCURRENCY=1

# Only needed when COUNCIL_RUNNER=api.
ANTHROPIC_API_KEY=
