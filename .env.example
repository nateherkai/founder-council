# The room can play councils run in Claude Code without API credentials.
# Set COUNCIL_RUNNER=api to run councils in the room using the selected API.
# Change LLM_PROVIDER to switch API providers; no code changes are needed.
# Supported values: anthropic, openai (case-insensitive).
LLM_PROVIDER=anthropic

# Anthropic API. Required only when LLM_PROVIDER=anthropic and COUNCIL_RUNNER=api.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI API. Required only when LLM_PROVIDER=openai and COUNCIL_RUNNER=api.
# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# "viewer" (default) or "api". Claude Code's /roast-room flow stays separate.
COUNCIL_RUNNER=viewer

# Used by /newroaster to make a new advisor's cartoon portrait (about 5 image jobs each).
# Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=
